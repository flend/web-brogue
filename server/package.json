{
  "name": "web-brogue",
  "version": "0.1.0",
  "description": "A web server for playing the Brogue over the internet. Brogue is a game for Mac OS X, Windows, and Linux by Brian Walker. For more information go https://sites.google.com/site/broguegame/. The server only can be run on a POSIX environment at the moment.",
  "contributors": [
    {
      "name": "Kristofer Raske",
      "email": "kip.raske@gmail.com"
    },
    {
      "name": "Tom Ford",
      "email": "flend@compsoc.net"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/flend/web-brogue"
  },
  "main": "server.js",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "client-sessions": "^0.8.0",
    "escape-html": "^1.0.3",
    "express": "^5.3.0",
    "fs-extra": "^11.4.1",
    "mongo-sanitize": "^1.1.0",
    "mongoose": "^9.11.4",
    "mongoose-paginate-v2": "^1.9.5",
    "morgan": "^1.12.1",
    "socket.io": "^4.8.4",
    "underscore": "^1.13.8",
    "unix-dgram": "^2.0.7"
  },
  "scripts": {
    "test": "mocha --timeout 10000",
    "start": "node server.js",
    "db": "node scripts/dev-mongo.js",
    "migrate:json": "node scripts/migrate-json.js"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "jsdom": "^30.1.3",
    "mocha": "^12.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "mongodb-memory-server-core": "^11.3.0"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "allowScripts": {
    "unix-dgram@2.0.7": true
  }
}
